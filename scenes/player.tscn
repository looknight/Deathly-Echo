[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/player.gd" id="1_p"]

[sub_resource type="CapsuleShape3D" id="caps"]
radius = 0.4
height = 1.8

[sub_resource type="BoxMesh" id="gun_mesh"]
size = Vector3(0.08, 0.12, 0.5)

[sub_resource type="StandardMaterial3D" id="mat_gun"]
albedo_color = Color(0.15, 0.15, 0.15, 1)

[node name="Player" type="CharacterBody3D" groups=["player"]]
script = ExtResource("1_p")

[node name="Collision" type="CollisionShape3D" parent="."]
